# Copy to .env and fill in. NEVER commit .env.
# Binance Futures TESTNET keys: https://testnet.binancefuture.com
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=

# Real-money keys (leave empty until the testnet run is profitable for weeks).
# Create the key with Futures trading ON and Withdrawals OFF, and restrict by IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Mainnet is refused unless this is exactly YES
CONFIRM_MAINNET=NO
